{
  "manifest_version": 3,
  "name": "VidMind",
  "short_name": "VidMind",
  "version": "1.0.0",
  "description": "Analyze the YouTube video you're watching with VidMind — transcript, summary, chapters, and grounded Q&A.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "VidMind"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"]
}
