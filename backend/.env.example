DATABASE_URL=sqlite:///./vidmind.db
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

WHISPER_BEAM_SIZE=1
# WHISPER_CPU_THREADS=8

# Local LLM (Ollama) writes summaries, chapters and answers. Falls back to the
# Hugging Face models below when Ollama isn't running. LLM_PROVIDER=none disables it.
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise Ollama.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=16384

SUMMARY_MODEL=sshleifer/distilbart-cnn-12-6
SUMMARY_DEVICE=cpu

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QA_MODEL=distilbert-base-cased-distilled-squad
SEARCH_SIMILARITY_THRESHOLD=0.3
QA_SIMILARITY_THRESHOLD=0.45

# TranscriptAPI.com key (https://transcriptapi.com): YouTube transcripts without
# yt-dlp. Needed when deployed to a server; 1 credit per video.
TRANSCRIPT_API_KEY=

YOUTUBE_TEMP_DIR=./processed/youtube_tmp
MAX_CONCURRENT_YOUTUBE_JOBS=2
# Set to chrome/firefox/safari if YouTube asks to "confirm you're not a bot".
YTDLP_COOKIES_FROM_BROWSER=
# Or export cookies.txt from a browser signed in to YouTube and point here.
YTDLP_COOKIES_FILE=

# --- Public deployment ---
# Sign-in with Supabase Auth. Empty = single-user local mode (no sign-in).
SUPABASE_URL=
# Only for Supabase projects still using the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# Limits per user (0 = unlimited).
DAILY_VIDEO_LIMIT=0
MAX_ACTIVE_JOBS_PER_USER=2
MAX_VIDEO_MINUTES=0
ASK_LIMIT_PER_HOUR=0
ENABLE_UPLOADS=true

# inline = jobs run inside the API process; queue = `python -m app.worker` runs them.
JOB_MODE=inline
WORKER_CONCURRENCY=2
