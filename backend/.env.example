# --- AI (one of these) ---
# Claude: fast, best quality. Leave empty to use Ollama locally instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise Ollama.
LLM_PROVIDER=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- YouTube transcripts ---
# TranscriptAPI.com key. Needed when deployed (YouTube blocks most servers);
# locally, leave empty to use yt-dlp.
TRANSCRIPT_API_KEY=
# yt-dlp only: if YouTube asks to "confirm you're not a bot", point this at a
# cookies.txt exported from a browser signed in to YouTube.
YTDLP_COOKIES_FILE=

# --- Frontend origins allowed to call the API (comma-separated) ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Cost and abuse limits (0 = unlimited) ---
ANALYSES_PER_IP_PER_DAY=5
ANALYSES_PER_DAY_TOTAL=200
QUESTIONS_PER_IP_PER_HOUR=30
MAX_VIDEO_MINUTES=180
RATE_LIMIT_PER_MINUTE=120

# --- Other ---
# Where finished analyses are cached (a persistent disk keeps them across deploys).
CACHE_DIR=./cache
ENABLE_DOCS=false
